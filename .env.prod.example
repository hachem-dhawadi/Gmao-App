# ================================================================
# GMAO Production Environment — Azure VM
# Copy to .env and fill in all values before first deploy
# ================================================================

# ── Docker / GHCR ──────────────────────────────────────────────
GITHUB_OWNER=hachemdhawadiRSE
IMAGE_TAG=latest
SERVER_IP=YOUR_AZURE_VM_PUBLIC_IP

# ── MySQL ──────────────────────────────────────────────────────
DB_DATABASE=gmao
DB_USERNAME=gmao_user
DB_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
DB_PASSWORD=CHANGE_ME_STRONG_USER_PASSWORD

# ── Laravel ────────────────────────────────────────────────────
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate

# ── Groq AI ────────────────────────────────────────────────────
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE
